Algoritmo "dardo"
// verifica qual dos 3 dardos foi mais longe

Var
d1,d2,d3,maior_distancia:real


Inicio
escreval("digite a primeira distancia:")
leia(d1)
escreval("digite a segunda distancia:")
leia(d1)
escreval("digite a terceira distancia:")
leia(d3)

se (d1>d2) e(d1>d3) entao
escreval ("maior distancia:",d1)
senao
se (d2>d1)e(d2>d3) entao
escreval ("maior distancia:",d2)

senao
escreva("maior distancia:",d3)

fimse
fimse

//esse ate que foi de boa,nao travei




Fimalgoritmo