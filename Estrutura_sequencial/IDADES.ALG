Algoritmo "idades"
//aqui é bem simples, o programa le dois nomes e duas idades e da a media deles
Var
nome1,nome2:caracter
idade1,idade2,media:real

Inicio
escreval("qual o primeiro nome? ")
leia(nome1)
escreval("qual o segundo nome? ")
leia(nome2)
escreval("qual a idade da primeira pessoa?")
leia(idade1)
escreval("qual a idade da segunda pessoa?")
leia(idade2)
media<- (idade1+idade2)/2

escreva(" a idade media de ",nome1," e ",nome2, " é ", media:3:1)


Fimalgoritmo