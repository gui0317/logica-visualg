Algoritmo "Consumo combustivel"
//programa deito pra calcular o valor gasto na distancia percorrida
//apos inserir o valores o programa faz o calculo disso
Var
Distancia_Percorrida,Valor_Gasto,Consumo_Medio:real

Inicio
escreval("qual a distancia percorrida?")
leia (Distancia_Percorrida)
escreval("qual valor o gasto?")
leia (Valor_Gasto)
Consumo_Medio<-Distancia_Percorrida/Valor_Gasto
escreva("consumo medio=",Consumo_Medio:4:2)


Fimalgoritmo