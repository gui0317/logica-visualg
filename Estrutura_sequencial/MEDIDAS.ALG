Algoritmo "medidas"
// Fazer um programa para ler três medidas A, B e C.
//Em seguida, calcular e mostrar imprimir os dados

Var
A,B,C,area_quadrado,area_triangulo,area_trapezio:real

Inicio
escreval("digite a medida A:")
leia(A)
escreval("digite a medida B:")
leia(B)
escreval("digite a medida C: ")
leia(C)
area_quadrado<-A*4
area_triangulo<- a*b/2
area_trapezio<- (a+b)*c/2
escreval("area do quadrado=",area_quadrado:2:4)
escreval("area do triangulo=",area_triangulo:2:4)
escreval("area do trapezio=",area_trapezio:2:4)
Fimalgoritmo