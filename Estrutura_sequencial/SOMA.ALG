Algoritmo "soma"
//este progrma le dois numero e soma, e imprime o resultado deles
Var
n1,n2,soma:inteiro

Inicio
escreval("escreva um numero pra somar:")
leia(n1)
escreval("escreva outro numero pra somar:")
leia(n2)
soma<-n1+n2
escreva("o resultado de ",n1 ," +",n2," é:",soma)



Fimalgoritmo